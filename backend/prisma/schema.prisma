generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("PARTICIPANT") // PARTICIPANT, ADMIN, JUDGE
  college      String?
  collegeId    String?
  phone        String?
  status       String   @default("REGISTERED") // REGISTERED, CHECKED_IN, DISQUALIFIED
  collegeIdVerified Boolean @default(false)
  checkedInAt  DateTime?
  disqualificationReason String?
  lockedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workstation  Workstation?
  submissions  Submission[]
  evaluations  Evaluation[]
}

model Workstation {
  id            String   @id @default(uuid())
  pcNumber      String   @unique
  participantId String?  @unique
  participant   User?    @relation(fields: [participantId], references: [id])
}

model Round {
  id        String      @id @default(uuid())
  name      String
  duration  Int         // in minutes
  startTime DateTime?
  endTime   DateTime?
  status    String      @default("PENDING") // PENDING, ACTIVE, PAUSED, ENDED
  lateEntryCutoffMinutes Int @default(10)
  autoSubmitOnEnd Boolean @default(true)
  pausedAt  DateTime?
  problems  Problem[]
}

model Problem {
  id           String   @id @default(uuid())
  title        String
  description  String
  inputFormat  String
  outputFormat String
  constraints  String
  difficulty   String
  timeLimit    Int      // in milliseconds
  memoryLimit  Int      // in MB
  roundId      String
  round        Round    @relation(fields: [roundId], references: [id])

  submissions  Submission[]
  testCases    TestCase[]
  examples     ProblemExample[]
}

model ProblemExample {
  id        String   @id @default(uuid())
  problemId String
  input     String
  output    String
  explanation String?
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model TestCase {
  id        String  @id @default(uuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id])
  input     String
  output    String
  isHidden  Boolean @default(true)
}

model Submission {
  id            String   @id @default(uuid())
  participantId String
  participant   User     @relation(fields: [participantId], references: [id])
  problemId     String
  problem       Problem  @relation(fields: [problemId], references: [id])
  language      String
  sourceCode    String
  status        String   // PENDING, ACCEPTED, WRONG_ANSWER, COMPILE_ERROR, RUNTIME_ERROR
  executionTime Int?     // in ms
  passedCases   Int      @default(0)
  totalCases    Int      @default(0)
  createdAt     DateTime @default(now())
}

model Evaluation {
  id                String   @id @default(cuid())
  participantId     String   @unique
  round1Score       Float    @default(0)
  round2Score       Float    @default(0)
  manualAdjustments Float    @default(0)
  judgeComments     String?
  codeQuality       Float    @default(0)
  logicClarity      Float    @default(0)
  finalScore        Float    @default(0)
  updatedAt         DateTime @updatedAt
  lockedAt          DateTime?
  lockedBy          String?

  participant       User     @relation(fields: [participantId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  adminId     String
  actionType  String
  description String
  timestamp   DateTime @default(now())
}

model ParticipantStatusHistory {
  id            String   @id @default(uuid())
  participantId String
  adminId       String
  fromStatus    String?
  toStatus      String
  reason        String?
  createdAt     DateTime @default(now())
}

model WorkstationAssignmentHistory {
  id            String   @id @default(uuid())
  workstationId String
  pcNumber      String
  participantId String?
  adminId       String
  action        String
  createdAt     DateTime @default(now())
}

model ScoreAdjustment {
  id                String   @id @default(uuid())
  participantId     String
  adminId           String
  round1Score       Float
  round2Score       Float
  manualAdjustments Float
  finalScore        Float
  reason            String
  reversedAt        DateTime?
  reversedBy        String?
  createdAt         DateTime @default(now())
}

model ContestSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt
}

model SuddenDeathRound {
  id                  String   @id @default(uuid())
  name                String
  duration            Int
  status              String   @default("PENDING")
  participantIds      String
  problemId           String?
  bonusPoints         Float    @default(0)
  startTime           DateTime?
  endTime             DateTime?
  createdBy           String
  createdAt           DateTime @default(now())
}
